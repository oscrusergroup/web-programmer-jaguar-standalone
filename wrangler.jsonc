{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaguar-web-programmer",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
